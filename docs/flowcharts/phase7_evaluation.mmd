flowchart TD
    INPUT(["lighting_instructions[]\n+ processed_scenes[]"]) --> L1

    subgraph L1["Layer 1: Trace Logger"]
        TL["TraceLogger(seed=42)"]
        TL --> EACH["Log each\nscene + instruction pair"]
        EACH --> HASH["SHA-256\ninput/output hashes"]
        HASH --> SAVE["Save trace JSON\nto data/traces/"]
    end

    L1 --> L2

    subgraph L2["Layer 2: Metrics Engine v1"]
        ME["MetricsEngine\n(available_groups)"]
        ME --> PI["Per-instruction:\ncoverage + diversity"]
        ME --> SEQ["Sequence:\ndrift_score"]
        PI --> RPT["generate_report()"]
        SEQ --> RPT
    end

    L2 --> L3

    subgraph L3["Layer 3: Evaluation Gate v2"]
        ADP["_build_emotion_distributions()\nadapter"]
        ADP --> GATE["EvaluationGate(output_dir)"]

        GATE --> PS
        subgraph PS["Per-Scene Evaluation"]
            STR["Structural:\nschema + hierarchy"]
            CON["Conflict:\ncolor + intensity + movement"]
            COH["Coherence:\nemotion-lighting alignment"]
            STR --> SV["Scene Verdict"]
            CON --> SV
            COH --> SV
        end

        GATE --> SL
        subgraph SL["Sequence-Level Evaluation"]
            DFT["Drift check\nwith thresholds"]
            EMV["Emotion-cue\nvariance"]
            NAR["Narrative arc\nvalidation"]
            TRN["Transition\nsmoothness"]
            STB["Cross-run\nstability"]
        end

        SV --> RECOMP["Recompute\nfinal verdicts"]
        SL --> RECOMP
        RECOMP --> REPORT["EvaluationReport"]
    end

    REPORT --> PROCEED{"should_proceed()?"}
    PROCEED --> |"yes"| PASS(["✅ Gate PASSED"])
    PROCEED --> |"no"| REVIEW(["⚠️ Review Recommended\n(non-blocking)"])

    style L1 fill:#2d3748,stroke:#a0aec0,color:#fff
    style L2 fill:#2d3748,stroke:#a0aec0,color:#fff
    style L3 fill:#553c9a,stroke:#b794f4,color:#fff
    style PS fill:#44337a,stroke:#9f7aea,color:#fff
    style SL fill:#44337a,stroke:#9f7aea,color:#fff
    style PASS fill:#276749,stroke:#68d391,color:#fff
    style REVIEW fill:#744210,stroke:#fbd38d,color:#fff
